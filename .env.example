# Passageworks — Environment Configuration
# Copy this file to .env or .env.local to customize your local execution.

# ==============================================================================
# Model Provider Settings (Groq API or OpenAI-Compatible Stand-in)
# ==============================================================================
# Your Groq API key (Required only when testing against the real Groq service).
# Leave empty or unset when running unit tests, CI, or stand-in benchmarks.
GROQ_API_KEY=

# Base URL for API requests.
# Default for Stand-in: http://127.0.0.1:8000/v1
# Default for Live Groq: (leave empty or unset to use official Groq cloud endpoint)
GROQ_BASE_URL=http://127.0.0.1:8000/v1

# Primary generative model for drafting answers and verification.
# Calibrated active model on Groq free-tier as of November 2026: qwen/qwen3.8-27b
PASSAGEWORKS_PRIMARY_MODEL=qwen/qwen3.8-27b

# Fast classifier model for scope gatekeeping (defaults to primary model if omitted).
PASSAGEWORKS_CLASSIFIER_MODEL=qwen/qwen3.8-27b

# ==============================================================================
# Concurrency & Admission Queue Parameters
# ==============================================================================
# Maximum number of pipeline requests actively executing simultaneously.
PASSAGEWORKS_MAX_CONCURRENT=3

# Maximum requests waiting in FIFO admission queue before rejecting with 429.
PASSAGEWORKS_MAX_QUEUE_DEPTH=25

# Hard deadline in seconds for queued + active request execution.
PASSAGEWORKS_REQUEST_DEADLINE_S=25.0

# ==============================================================================
# Client-Side Token Budget Tracker (Groq Free-Tier Guardrails)
# ==============================================================================
# Rolling 60-second Tokens-Per-Minute (TPM) limit.
PASSAGEWORKS_TPM_LIMIT=8000

# Rolling 60-second Requests-Per-Minute (RPM) limit.
PASSAGEWORKS_RPM_LIMIT=30

# Daily token ceiling before client pre-empts requests with graceful refusal.
PASSAGEWORKS_DAILY_TOKEN_LIMIT=500000

# Daily request ceiling.
PASSAGEWORKS_DAILY_REQUEST_LIMIT=1000

# ==============================================================================
# Client Retry & Backoff Configuration
# ==============================================================================
# Maximum application-level retries on upstream transient failures (429, 500, 503).
PASSAGEWORKS_MAX_RETRIES=2

# Base exponential backoff in seconds (scales as base * 2^(attempt - 1)).
PASSAGEWORKS_BACKOFF_BASE_S=1.0

# Request timeout in seconds for individual LLM streaming API calls.
PASSAGEWORKS_REQUEST_TIMEOUT_S=15.0

# Maximum lockout in seconds before the client fast-fails instead of sleeping.
PASSAGEWORKS_FAST_FAIL_LOCKOUT_S=10.0

# ==============================================================================
# Stand-in Simulation Server Parameters
# ==============================================================================
# Host and port for the local FastAPI stand-in service.
STANDIN_HOST=127.0.0.1
STANDIN_PORT=8000

# Calibrated base time-to-first-token in milliseconds.
STANDIN_BASE_TTFT_MS=210.0

# Jitter range (+/-) in milliseconds around base TTFT.
STANDIN_TTFT_JITTER_MS=45.0

# Streaming interval per token in milliseconds (~330 tokens/sec on Groq LPU).
STANDIN_TOKEN_INTERVAL_MS=3.0

# Concurrency degradation factor (latency scales as 1.0 + factor * (active - 1)).
STANDIN_LOAD_SLOWDOWN_FACTOR=0.15
